---
import {site} from '../data/site';

const skills = ['HTML', 'CSS', 'JavaScript', 'Astro'];
---


<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About</title>
</head>
<body>
    <h1>About me</h1>
    <p>{site.bio}</p>
    <h2>Skills:</h2>
    {skills.map((skill) => (
        <span class="tag">{skill}</span>
    ))}
</body>
</html>